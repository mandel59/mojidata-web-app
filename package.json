{
  "name": "mojidata-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:spa-assets": "node scripts/copy-spa-assets.mjs",
    "predev": "npm run prepare:spa-assets",
    "dev": "next dev --webpack",
    "prebuild": "npm run prepare:spa-assets",
    "build": "next build --webpack",
    "start": "next start",
    "cf:clean-cache": "node scripts/clean-cloudflare-build-cache.mjs",
    "cf:build": "npm run cf:clean-cache && node scripts/run-cloudflare-build.mjs",
    "cf:build:asset-worker": "node scripts/run-cloudflare-asset-release-build.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:deploy:asset-worker": "npm run cf:build:asset-worker && npm run cf:deploy",
    "cf:upload": "opennextjs-cloudflare upload",
    "cf:populate-cache": "opennextjs-cloudflare populateCache",
    "cf:typegen": "wrangler types",
    "cf:upload-spa-assets": "node scripts/upload-spa-assets-to-r2.mjs",
    "test:release-assets": "node --test scripts/copy-spa-assets.test.mjs",
    "cf:asset-worker:dry-run": "node node_modules/wrangler/bin/wrangler.js deploy --config wrangler.spa-assets.jsonc --dry-run --outdir dist/spa-asset-worker",
    "cf:asset-worker:deploy": "node node_modules/wrangler/bin/wrangler.js deploy --config wrangler.spa-assets.jsonc",
    "cf:generate-glyph-path-shards": "node --max-old-space-size=8192 scripts/generate-glyph-path-shards.mjs",
    "cf:upload-glyph-path-shards": "node scripts/upload-glyph-path-shards-to-r2.mjs",
    "crawl-spa:build": "node scripts/build-crawl-spa.mjs",
    "crawl-spa:verify": "npm run crawl-spa:build && node scripts/verify-crawl-spa.mjs",
    "crawl-spa:deploy": "npm run crawl-spa:build && npx wrangler pages deploy dist/crawl-spa --project-name mojidata-crawl --branch cloudflare",
    "crawl-spa:deploy:asset-worker": ": ${MOJIDATA_SPA_ASSET_RELEASE:?Set MOJIDATA_SPA_ASSET_RELEASE to the R2 SPA asset release id} && MOJIDATA_CRAWL_SPA_ASSET_BASE_URL=${MOJIDATA_CRAWL_SPA_ASSET_BASE_URL:-https://mojidata-spa-assets.mandel59.workers.dev/releases/$MOJIDATA_SPA_ASSET_RELEASE} MOJIDATA_CRAWL_SPA_ASSET_VERSION=${MOJIDATA_CRAWL_SPA_ASSET_VERSION:-$MOJIDATA_SPA_ASSET_RELEASE} npm run crawl-spa:deploy",
    "crawl-spa:redirect:dry-run": "node scripts/configure-crawl-bot-redirect.mjs --dry-run",
    "crawl-spa:redirect:apply": "node scripts/configure-crawl-bot-redirect.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint",
    "lint:css": "stylelint 'src/**/*.css' 'crawl-spa/**/*.css'",
    "refresh:storybook-fixtures": "./scripts/refresh-storybook-svg-fixtures.sh",
    "test:e2e": "playwright test",
    "test:e2e:target": "node scripts/run-playwright-target.mjs",
    "test:sequential": "node scripts/run-sequential.mjs",
    "verify:ui:sequential": "node scripts/run-sequential.mjs --cmd \"npm run test:e2e:target -- -- 'tests/e2e/chrome-visual.spec.ts' --project=chromium\" --cmd \"npm run test:e2e:target -- -- 'tests/e2e/search-visual.spec.ts' --project=chromium\" --cmd \"npm run test:e2e:target -- -- 'tests/e2e/mojidata.spec.ts' --project=chromium --grep 'desktop mojidata keeps the TOC sidebar beside the main content|moji_joho display mode toggles without route refetch'\" --cmd \"npm run test:e2e:target -- -- 'tests/e2e/bot-rewrite.spec.ts' --project=chromium --grep 'mobile non-SPA search page can use search examples|mobile non-SPA search results page keeps form usable|mobile non-SPA idsfind results page keeps form usable'\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:smoke": "node scripts/run-storybook-smoke.mjs",
    "storybook:visual": "node scripts/run-storybook-smoke.mjs --spec tests/e2e/storybook-visual.spec.ts",
    "visual:compare": "node scripts/run-visual-suite.mjs compare",
    "visual:compare:3000": "node scripts/run-visual-suite.mjs compare --port 3000",
    "visual:refresh-baseline": "node scripts/run-visual-suite.mjs refresh-baseline",
    "verify:style-system": "node scripts/run-sequential.mjs --cmd \"npm run build-storybook\" --cmd \"npm run storybook:smoke\" --cmd \"npm run storybook:visual\" --cmd \"npm run visual:compare\"",
    "compare:styles": "node scripts/compare-rendered-styles.mjs",
    "compare:mojidata:layout": "node scripts/compare-mojidata-layout.mjs",
    "compare:mojidata:sections": "node scripts/compare-mojidata-sections.mjs",
    "compare:mojidata:regional": "node scripts/compare-mojidata-regional-section.mjs"
  },
  "dependencies": {
    "@mandel59/idsdb": "^1.8.0",
    "@mandel59/idsdb-fts5": "^1.10.0",
    "@mandel59/idsdb-utils": "^1.8.0",
    "@mandel59/mojidata": "^1.9.1",
    "@mandel59/mojidata-api": "^3.1.0",
    "@mandel59/mojidata-api-core": "^1.11.0",
    "@mandel59/mojidata-api-runtime": "^2.1.0",
    "@mandel59/mojidata-api-sqlite-wasm": "^1.10.0",
    "@mandel59/mojidata-api-sqljs": "^1.9.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.28",
    "raw-loader": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "resolve-accept-language": "^3.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@types/opentype.js": "^1.3.10",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-storybook": "^10.6.0",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.132.0"
  }
}
